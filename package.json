{
  "name": "vonco_partners",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "lh:mobile": "mkdir -p .lighthouse && npx lighthouse https://vonco.partners/en --only-categories=performance,seo --chrome-flags='--headless' --output=json --output=html --output-path=./.lighthouse/mobile",
    "lh:desktop": "mkdir -p .lighthouse && npx lighthouse https://vonco.partners/en --only-categories=performance,seo --preset=desktop --chrome-flags='--headless' --output=json --output=html --output-path=./.lighthouse/desktop",
    "lh:compare": "node scripts/lighthouse-compare.mjs ./.lighthouse/mobile-report.report.json ./.lighthouse/mobile-report-after.report.json"
  },
  "dependencies": {
    "ai": "^6.0.100",
    "better-sqlite3": "^12.2.0",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.23.12",
    "lucide-react": "^0.575.0",
    "negotiator": "^1.0.0",
    "next": "^16.1.6",
    "next-intl": "^4.8.2",
    "openai": "^6.25.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-icons": "^5.5.0",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@next/bundle-analyzer": "^16.1.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.33",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6",
    "typescript": "^5.9.3"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "Edge >= 100",
    "iOS >= 15",
    "not dead",
    "not ie 11"
  ]
}
